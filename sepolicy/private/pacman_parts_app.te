app_domain(pacman_parts_app)
allow pacman_parts_app app_api_service:service_manager find;
allow pacman_parts_app sysfs_devices_system_cpu:dir r_dir_perms;
allow pacman_parts_app sysfs_devices_system_cpu:file r_file_perms;
allow pacman_parts_app proc_stat:file r_file_perms;
allow pacman_parts_app sysfs_thermal:dir r_dir_perms;
allow pacman_parts_app sysfs_thermal:file { getattr open read };
allow pacman_parts_app audioserver_service:service_manager find;
