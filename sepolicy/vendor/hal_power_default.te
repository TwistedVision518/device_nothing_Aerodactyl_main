typeattribute hal_power_default mlstrustedsubject;

allow hal_power_default vendor_sysfs_graphics:dir r_dir_perms;
allow hal_power_default vendor_sysfs_graphics:file rw_file_perms;

# ADPF uclamp and scheduling permissions
allow hal_power_default self:capability sys_nice;
allow hal_power_default { appdomain hal_graphics_composer_default surfaceflinger system_server }:process { getsched setsched };

# sys_ptrace is blocked by platform neverallow (domain.te:1674).
# Suppress audit spam — the power HAL probes for ptrace and falls back gracefully.
dontaudit hal_power_default self:capability sys_ptrace;

