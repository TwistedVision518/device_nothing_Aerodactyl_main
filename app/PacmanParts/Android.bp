// SPDX-License-Identifier: Apache-2.0
// Speaker tone and dashboard icons from Onyx-Odyssey/android_device_xiaomi_onyx
// at 00aaae44696a9dff850c2f88a1ac7b25491978d4.
android_app {
    // Change the install path so Package Manager reparses metadata from older builds.
    name: "PacmanPartsSettings",
    defaults: ["SettingsLibDefaults"],
    srcs: ["src/**/*.kt"],
    certificate: "platform",
    platform_apis: true,
    system_ext_specific: true,
    static_libs: [
        "androidx.appcompat_appcompat",
        "androidx.lifecycle_lifecycle-livedata-core",
        "androidx.lifecycle_lifecycle-viewmodel",
        "androidx.preference_preference",
        "org.lineageos.settings.resources",
    ],
}
